    {
      "id": "global-core",
      "sources": [
        {
          "id": "natural-earth-populated-places",
          "title": "Natural Earth populated places",
          "adapter": "shapefile",
          "identity_authority": "natural-earth",
          "location": "https://naturalearth.s3.amazonaws.com/10m_cultural/ne_10m_populated_places.zip",
          "kind": "place",
          "id_fields": ["NE_ID", "WIKIDATAID", "NAME"],
          "name_fields": ["NAME", "NAMEPAR", "NAMEASCII"],
          "country_fields": ["ISO_A2", "ADM0_A3"],
          "region_fields": ["ADM1NAME"],
          "capabilities": ["locality"],
          "identifiers": [
            {"authority": "natural-earth", "scheme": "natural_earth", "field": "NE_ID", "primary": true},
            {"authority": "wikidata", "scheme": "wikidata", "field": "WIKIDATAID", "primary": false}
          ],
          "expected_min": 7000,
          "source_quality": 0.86,
          "licence": "Natural Earth public domain"
        },
        {
          "id": "natural-earth-admin1",
          "title": "Natural Earth first-level administration",
