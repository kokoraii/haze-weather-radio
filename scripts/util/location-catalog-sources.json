        {
          "id": "nga-gns-populated-places",
          "title": "NGA GNS foreign populated place names",
          "adapter": "delimited",
          "identity_authority": "nga-gns",
          "location": "https://geonames.nga.mil/geonames/GNSData/fc_files/Populated_Places.zip",
          "archive_contains": "Populated_Places.txt",
          "archive_suffix": ".txt",
          "delimiter": "\t",
          "kind": "place",
          "id_fields": ["ufi"],
          "name_fields": ["full_name"],
          "locale_field": "lang_cd",
          "primary_name_when": {"field": "nt", "values": ["N"]},
          "include_when_present": ["name_rank"],
          "attribute_fields": [
            "desig_cd",
            "fc",
            "cc_ft",
            "adm1",
            "name_rank",
            "nt",
            "script_cd",
            "generic",
            "full_nm_nd",
            "efctv_dt",
            "term_dt_f",
            "term_dt_n",
            "mod_dt_ft",
            "mod_dt_nm"
          ],
          "country_fields": ["cc_ft"],
          "region_fields": ["adm1"],
          "latitude_field": "lat_dd",
          "longitude_field": "long_dd",
          "capabilities": ["locality"],
          "identifiers": [
            {"authority": "nga", "scheme": "gns", "field": "ufi", "primary": true},
            {"authority": "nga", "scheme": "gns_name", "field": "uni", "primary": false}
          ],
          "lifecycle": "active",
          "inactive_when_field_present": "term_dt_f",
          "valid_from_field": "efctv_dt",
          "valid_to_field": "term_dt_f",
          "expected_min": 4000000,
          "source_quality": 0.96,
          "licence": "United States government work",
          "attribution": "National Geospatial-Intelligence Agency Geographic Names Server"
        },
        {
          "id": "usgs-gnis-domestic",
          "title": "USGS GNIS Domestic Names",
          "adapter": "delimited",
          "identity_authority": "usgs-gnis",
          "location": "https://prd-tnm.s3.amazonaws.com/StagedProducts/GeographicNames/DomesticNames/DomesticNames_National_Text.zip",
          "archive_contains": "DomesticNames_National.txt",
          "archive_suffix": ".txt",
          "delimiter": "|",
          "kind_field": "feature_class",
          "id_fields": ["feature_id"],
          "name_fields": ["feature_name"],
          "country": "US",
          "region_fields": ["state_name"],
          "latitude_field": "prim_lat_dec",
          "longitude_field": "prim_long_dec",
          "identifiers": [
            {"authority": "usgs", "scheme": "gnis", "field": "feature_id", "primary": true}
          ],
          "expected_min": 2000000,
          "source_quality": 0.96,
          "licence": "United States public domain",
          "attribution": "U.S. Geological Survey Geographic Names Information System"
        }
