<?xml version="1.0" encoding="UTF-8"?>
<feed enabled="true" timezone="America/Toronto">

    <playout routine="true" same="true" same_originator="EAS"/>

    <alerts>
      <cap_cp enabled="true">
        <filter use_feed_locations="true" coverage_mode="polygon_first">
          <blocklist>
            <severity>Minor</severity>
            <severity>Unknown</severity>
            <certainty>Unknown</certainty>
            <certainty>Past</certainty>
            <naads_event>fog</naads_event>
            <other value_name="layer:EC-MSC-SMC:1.0:Alert_Type" value="advisory"/>
